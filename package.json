{
  "name": "tara-local-meeting-assistant",
  "private": true,
  "version": "0.4.1-beta.1",
  "description": "Privacy-first desktop meeting intelligence assistant.",
  "author": "Håkon Pilvik",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pilvik1/tara-local-meeting-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/Pilvik1/tara-local-meeting-assistant/issues"
  },
  "homepage": "https://github.com/Pilvik1/tara-local-meeting-assistant#readme",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "backend": "node scripts/start-backend.cjs",
    "backend:install": "python3 -m venv .venv && .venv/bin/python -m pip install -r backend/requirements.txt",
    "dev": "concurrently -k \"npm:backend\" \"vite --host 127.0.0.1\"",
    "dev:tailnet": "concurrently -k \"npm:backend\" \"vite --host 0.0.0.0\"",
    "electron": "concurrently -k \"npm:backend\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:doctor": "node scripts/desktop-doctor.cjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm run test:frontend && npm run lint && npm run build",
    "audit:production": "npm audit --omit=dev",
    "audit:build": "npm audit --audit-level=high",
    "test:backend": "python -m unittest discover -s backend/tests -v",
    "test:frontend": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24",
    "python": ">=3.11"
  },
  "build": {
    "appId": "io.github.pilvik1.tara",
    "productName": "Tara",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "backend-dist/tara-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "local-runtime",
        "to": "local-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.3"
  }
}
