# Tara works without environment configuration. These are optional development
# overrides; never commit real credentials.
TARA_API_HOST=127.0.0.1
TARA_API_PORT=8765
TARA_WHISPER_MODEL=small
TARA_WHISPER_DEVICE=cpu
TARA_WHISPER_COMPUTE_TYPE=int8
TARA_WHISPER_LANGUAGE=auto

# Optional SMTP delivery (moves selected meeting text outside the device).
# TARA_SMTP_HOST=smtp.example.com
# TARA_SMTP_PORT=587
# TARA_SMTP_TLS=true
# TARA_SMTP_FROM=tara@example.com
# TARA_SMTP_USERNAME=tara@example.com
# TARA_SMTP_PASSWORD=use-an-app-password
